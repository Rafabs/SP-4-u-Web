---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="404 - Estação Não Encontrada | Sampa 4u">
    <div class="error-wrapper">
        <div class="error-container">
            <div class="error-icon">
                <span class="material-symbols-outlined" style="font-size: 4rem; color: #ffcc00;">traffic</span>
                <span class="material-symbols-outlined" style="font-size: 5rem;">train</span>
                <span class="material-symbols-outlined" style="font-size: 4rem; color: #ff4444;">wrong_location</span>
            </div>
            <h1>404</h1>
            <h2>Ops... Estação Não Encontrada :(</h2>
            <p>Parece que o trem mudou de rota ou esta linha ainda está em obras.</p>

            <a href={`${base}/`} class="btn-home">
                <span class="material-symbols-outlined" style="vertical-align: middle;">arrow_back</span> 
                Por favor, embarque no próximo trem (Início)
            </a>
        </div>
    </div>
</Layout>

<style>
    .error-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh; /* Ajustado para não brigar com header/footer do Layout */
        text-align: center;
        background-color: transparent;
        font-family: system-ui, -apple-system, sans-serif;
        padding: 20px;
    }
    .error-container {
        max-width: 500px;
    }
    .error-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }
    h1 {
        font-size: 6rem;
        margin: 0;
        color: var(--text-color, #333);
    }
    h2 {
        margin-bottom: 1rem;
        color: var(--text-color, #555);
    }
    p {
        margin-bottom: 2rem;
        color: var(--text-color, #777);
    }
    .btn-home {
        display: inline-block;
        padding: 12px 24px;
        background-color: #0078D4;
        color: white;
        text-decoration: none;
        border-radius: 30px;
        font-weight: bold;
        transition: transform 0.2s, background-color 0.2s;
    }
    .btn-home:hover {
        background-color: #005a9e;
        transform: scale(1.05);
    }
</style>
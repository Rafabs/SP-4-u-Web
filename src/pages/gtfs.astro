---
import Layout from "../layouts/Layout.astro";
import { historyData } from "../data/gtfs_history";

const base = import.meta.env.BASE_URL;

const recentes = historyData.filter((item) => item.recente);
const todos = historyData;

function badgeUrl(linha: string, cor: string): string {
  const label = linha.replace(/-/g, "--").replace(/ /g, "_");
  return `https://img.shields.io/badge/${label}-${cor}.svg`;
}
---

<Layout title="Sampa 4u | Histórico de Linhas">
  <link rel="stylesheet" href={`${base}/gtfs.css`} slot="head" />

  <!-- HERO -->
  <section class="hero hero-gtfs">
    <div class="hero-bg">
      <div class="hero-grid"></div>
    </div>

    <div class="hero-lines" id="gtfs-canvas"></div>

    <div class="hero-content">
      <div class="hero-tag">Dados Abertos · GTFS</div>
      <h1 class="hero-h1">Histórico de<br><span style="color:#00b352;">Linhas GTFS</span></h1>
      <p class="hero-sub">
        Acompanhe as atualizações da base de dados GTFS — novas linhas,
        alterações de rota e modificações operacionais do sistema metropolitano.
      </p>
      <div class="hero-ctas">
        <a href="#ultimas" class="btn-hero-primary" style="background:#00b352;">Ver atualizações</a>
        <a href="#historico" class="btn-hero-ghost">Histórico completo</a>
      </div>
      <div class="hero-stats">
        <div class="stat" style="border-color:#00b352;">
          <div class="stat-val">{recentes.length}</div>
          <div class="stat-label">Atualizações recentes</div>
        </div>
        <div class="stat" style="border-color:#00b352;">
          <div class="stat-val">{todos.length}</div>
          <div class="stat-label">Registros totais</div>
        </div>
        <div class="stat" style="border-color:#00b352;">
          <div class="stat-val">GTFS</div>
          <div class="stat-label">Formato aberto</div>
        </div>
      </div>
    </div>
  </section>

  <section id="ultimas">
    <h2>
      <span class="material-symbols-outlined" style="vertical-align: middle;">push_pin</span>
      Últimas Atualizações
    </h2>
    <div class="table-wrapper">
      <table class="history-table">
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Linha</th>
            <th>Rota</th>
          </tr>
        </thead>
        <tbody>
          {recentes.map((item) => (
            <tr>
              <td>{item.tipo}</td>
              <td><img src={badgeUrl(item.linha, item.cor)} alt={item.linha} /></td>
              <td set:html={item.rota} />
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <br />

    <details class="note" id="historico" style="padding: 15px; cursor: pointer;">
      <summary><strong>📚 Ver histórico completo</strong></summary>
      <div style="margin-top: 15px;">
        <table class="history-table">
          <thead>
            <tr>
              <th>Data</th>
              <th>Tipo</th>
              <th>Linha</th>
              <th>Rota</th>
            </tr>
          </thead>
          <tbody>
            {todos.map((item) => (
              <tr>
                <td>{item.data}</td>
                <td>{item.tipo}</td>
                <td><img src={badgeUrl(item.linha, item.cor)} alt={item.linha} /></td>
                <td set:html={item.rota} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <hr />
  <div id="dynamic-systems-info"></div>
  <hr />

  <section class="about">
    <div class="info-container">
      <h2>Desenvolvimento e Transparência</h2>
      <p>
        Este é um projeto de código aberto sob constante atualização. Você pode
        acompanhar o histórico de melhorias, contribuir com novas
        funcionalidades ou reportar inconsistências através do repositório oficial.
      </p>
      <div class="actions" style="margin-bottom: 20px;">
        <a href="https://github.com/Rafabs/SP-4-u-Web" target="_blank">
          <img
            src="https://img.shields.io/badge/GitHub-100000?style=for-the-badge&logo=github&logoColor=white"
            alt="github"
          />
        </a>
      </div>
      <p>
        <strong>Status do Build:</strong> Todas as atualizações seguem o fluxo de
        integração contínua.
      </p>
    </div>
  </section>

  <script>
    // Animação horizontal — mesmo padrão da SPTrans
    const COLORS = [
      '#00b352','#009966','#00cc44','#007733',
      '#00aa44','#008833','#00bb55','#006622',
    ];
    const canvas = document.getElementById('gtfs-canvas');
    if (canvas) {
      COLORS.forEach((color, i) => {
        const y = 40 + i * 55;

        // Trilho horizontal
        const track = document.createElement('div');
        track.style.cssText = `
          position:absolute;left:0;right:0;
          top:${y}px;height:2px;
          background:${color};opacity:.12;
        `;
        canvas.appendChild(track);

        // Ícone animado da esquerda para direita
        const pkg = document.createElement('span');
        pkg.className = 'material-symbols-outlined';
        pkg.textContent = i % 5 === 0 ? 'train'
          : i % 5 === 1 ? 'directions_bus'
          : i % 5 === 2 ? 'schedule'
          : i % 5 === 3 ? 'route'
          : 'transfer_within_a_station';
        pkg.style.cssText = `
          position:absolute;top:${y - 12}px;
          font-size:${18 + (i % 3) * 6}px;
          color:${color};opacity:.6;
          animation:bus-run ${6 + i * 1.2}s linear infinite;
          animation-delay:${-i * 0.8}s;
        `;
        canvas.appendChild(pkg);
      });
    }
  </script>
</Layout>
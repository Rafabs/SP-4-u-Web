---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Pesquisa Origem e Destino">
  <link rel="stylesheet" href={`${base}/od.css`} />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />

  <main class="dashboard-main">
    <section>
      <header class="od-header-card">
        <div class="header-text">
          <h1>Pesquisa Origem e Destino <span>OD</span></h1>
          <p>O estudo revela os novos padrões de deslocamento na <span>Região Metropolitana de São Paulo</span>, auxiliando no planejamento do transporte público e na expansão da rede metroviária.</p>
        </div>

        <div class="controls-container">
          <div class="od-selector-box">
            <label>ZONA</label>
            <select id="zone-selector"><option>Carregando...</option></select>
          </div>

          <div class="od-selector-box">
            <label>ANO PRINCIPAL</label>
            <select id="ano-selector"></select>
          </div>

          <div class="comparar-box">
            <label>COMPARAR COM:</label>
            <div id="comparar-anos"></div>
          </div>
        </div>
      </header>

      <div class="map-container">
        <div id="map" style="height: 400px; width: 100%; border-radius: 8px;">
        </div>
      </div>

      <div class="stats-container">
        <div class="stat-item">
          <span class="stat-label">População</span><span
            id="stat-pop"
            class="stat-value">--</span
          >
        </div>
        <div class="stat-item">
          <span class="stat-label">Empregos</span><span
            id="stat-jobs"
            class="stat-value">--</span
          >
        </div>
        <div class="stat-item">
          <span class="stat-label">Frota</span><span
            id="stat-cars"
            class="stat-value">--</span
          >
        </div>
        <div class="stat-item accent">
          <span class="stat-label">Renda Capita</span><span
            id="stat-income"
            class="stat-value">--</span
          >
        </div>
      </div>

      <div class="charts-grid">
        <div class="chart-card full-width">
          <h3>Modos de Transporte - Evolução</h3>
          <div class="canvas-holder wide">
            <canvas id="chart-modos"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Perfil por Gênero</h3>
          <div class="canvas-holder"><canvas id="chart-genero"></canvas></div>
        </div>

        <div class="chart-card">
          <h3>Distribuição por Idade</h3>
          <div class="canvas-holder"><canvas id="chart-idade"></canvas></div>
        </div>

        <div class="chart-card">
          <h3>Nível de Escolaridade</h3>
          <div class="canvas-holder">
            <canvas id="chart-escolaridade"></canvas>
          </div>
        </div>

        <div class="chart-card full-width">
          <h3>Motivos de Viagem - Evolução</h3>
          <div class="canvas-holder wide">
            <canvas id="chart-motivos"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Vínculo Empregatício</h3>
          <div class="canvas-holder"><canvas id="chart-vinculo"></canvas></div>
        </div>

        <div class="chart-card">
          <h3>Condição de Atividade</h3>
          <div class="canvas-holder">
            <canvas id="chart-atividade"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Matrículas Escolares</h3>
          <div class="canvas-holder">
            <canvas id="chart-matriculas"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Empregos por Setor</h3>
          <div class="canvas-holder">
            <canvas id="chart-empregos-setor"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Empregos por Vínculo</h3>
          <div class="canvas-holder">
            <canvas id="chart-empregos-vinculo"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Trabalho Externo vs Interno</h3>
          <div class="canvas-holder">
            <canvas id="chart-trabalho-externo"></canvas>
          </div>
        </div>

        <div class="chart-card full-width">
          <h3>Viagens Produzidas por Modo - Evolução</h3>
          <div class="canvas-holder wide">
            <canvas id="chart-viagens-comparativo"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Tempo Médio de Viagem</h3>
          <div class="canvas-holder">
            <canvas id="chart-tempo-viagem"></canvas>
          </div>
        </div>

        <div class="chart-card">
          <h3>Razões para Viagens a Pé</h3>
          <div class="canvas-holder">
            <canvas id="chart-razoes-pe"></canvas>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script is:inline type="module" src={`${base}/od-logic.js`}></script>

<script define:vars={{ base }}>
  let isInitialized = false;

  const startDashboard = () => {
    if (isInitialized) return; // Impede execução duplicada
    
    if (window.initODDashboard && document.getElementById("zone-selector")) {
      isInitialized = true;
      window.initODDashboard(base);
    } else {
      setTimeout(startDashboard, 100);
    }
  };

  document.addEventListener('DOMContentLoaded', startDashboard);
</script>
</Layout>

---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Qualidade do Ar - Sampa 4u">
  <link rel="stylesheet" href={`${base}/map.css`} slot="head" />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    slot="head"
  />

  <div class="map-wrapper">
    <div id="map"></div>
    <div id="map-controls" class="custom-controls">
      <h3>Qualidade do Ar (AQI)</h3>
      <label>
        <input type="checkbox" id="check-aqi" checked /> Estações Ativas
      </label>
      <div class="aqi-legend-mini" style="margin-top: 10px; font-size: 0.8rem; line-height: 1.4;">
        <div style="color: #009966;">● 0-50 Bom</div>
        <div style="color: #ffde33;">● 51-100 Moderado</div>
        <div style="color: #ff9933;">● 101-150 Inadequado</div>
        <div style="color: #cc0033;">● 151+ Prejudicial</div>
      </div>
    </div>
  </div>

  <hr />
  <div id="dynamic-systems-info"></div>
  <hr />

  <section class="about">
    <div class="info-container">
      <h2>Desenvolvimento e Transparência</h2>
      <p>
        Os dados de Qualidade do Ar são processados em tempo real via API do
        World Air Quality Index (WAQI), integrando estações da CETESB e redes colaborativas.
      </p>
      <div class="actions" style="margin-bottom: 20px;">
        <a href="https://github.com/Rafabs/SP-4-u-Web" target="_blank">
          <img
            src="https://img.shields.io/badge/GitHub-100000?style=for-the-badge&logo=github&logoColor=white"
            alt="github"
          />
        </a>
      </div>
      <p>
        <strong>Status do Build:</strong> Todas as atualizações seguem o fluxo de
        integração contínua.
      </p>
    </div>
  </section>

  <script>
    import { loadAQIData, setupAQIControls } from "../lib/qualidade_ar";

    setupAQIControls();
    loadAQIData();
  </script>
</Layout>
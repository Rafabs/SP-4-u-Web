---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
const aqiToken = import.meta.env.PUBLIC_AQI_API_KEY; 
---

<Layout title="Qualidade do Ar - Sampa 4u">
  <link rel="stylesheet" href={`${base}/map.css`} slot="head" />
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    slot="head"
  />

  <div class="map-wrapper">
    <div id="map"></div>
    <div id="map-controls" class="custom-controls">
        <h3>Qualidade do Ar (AQI)</h3>
        <label><input type="checkbox" id="check-aqi" checked> Estações Ativas</label>
        <div class="aqi-legend-mini" style="margin-top: 10px; font-size: 0.8rem; line-height: 1.4;">
          <div style="color: #009966;">● 0-50 Bom</div>
          <div style="color: #ffde33;">● 51-100 Moderado</div>
          <div style="color: #ff9933;">● 101-150 Inadequado</div>
          <div style="color: #cc0033;">● 151+ Prejudicial</div>
        </div>
    </div>
  </div>

  <hr>
  <div id="dynamic-systems-info"></div>
  <hr>

  <section class="about">
    <div class="info-container">
      <h2>Desenvolvimento e Transparência</h2>
      <p>
        Os dados de Qualidade do Ar são processados em tempo real via API do 
        World Air Quality Index (WAQI), integrando estações da CETESB e redes colaborativas.
      </p>
      <div class="actions" style="margin-bottom: 20px;">
        <a href="https://github.com/Rafabs/SP-4-u-Web" target="_blank">
          <img src="https://img.shields.io/badge/GitHub-100000?style=for-the-badge&logo=github&logoColor=white" alt="github">
        </a>
      </div>
      <p><strong>Status do Build:</strong> Todas as atualizações seguem o fluxo de integração contínua.</p>
    </div>
  </section>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  
  <script is:inline define:vars={{ aqiToken }}>
    // Inicialização do Mapa seguindo o padrão do seu projeto
    const map = L.map("map", {
        preferCanvas: true,
        tap: false
    }).setView([-23.5505, -46.6333], 11);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    const aqiLayer = L.layerGroup().addTo(map);

    function getAQIColor(aqi) {
        if (aqi <= 50) return "#009966";
        if (aqi <= 100) return "#ffde33";
        if (aqi <= 150) return "#ff9933";
        return "#cc0033";
    }

    async function loadAQIData() {
        if (!aqiToken) {
            console.error("AQI Token não encontrado.");
            return;
        }

        try {
            // Bounds de São Paulo e arredores
            const bounds = "-24.00,-47.00,-23.30,-46.20";
            const response = await fetch(`https://api.waqi.info/map/bounds/?latlng=${bounds}&token=${aqiToken}`);
            const json = await response.json();

            if (json.status === "ok") {
                aqiLayer.clearLayers();
                json.data.forEach(station => {
                    const color = getAQIColor(station.aqi);
                    L.circleMarker([station.lat, station.lon], {
                        radius: 10,
                        fillColor: color,
                        color: "#fff",
                        weight: 2,
                        opacity: 1,
                        fillOpacity: 0.8
                    })
                    .addTo(aqiLayer)
                    .bindPopup(`
                        <div style="text-align:center">
                            <strong>${station.station.name}</strong><br>
                            <h2 style="margin:5px 0; color:${color}">AQI: ${station.aqi}</h2>
                            <small>Atualizado em: ${station.station.time}</small>
                        </div>
                    `);
                });
            }
        } catch (error) {
            console.error("Erro ao carregar dados AQI:", error);
        }
    }

    // Controle da Camada
    document.getElementById('check-aqi').addEventListener('change', (e) => {
        if (e.target.checked) {
            map.addLayer(aqiLayer);
        } else {
            map.removeLayer(aqiLayer);
        }
    });

    // Início
    loadAQIData();
  </script>
</Layout>
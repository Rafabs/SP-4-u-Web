---
import Layout from "../layouts/Layout.astro";
const base = (import.meta.env.BASE_URL ?? "").replace(/\/$/, "") + "/";
---

<Layout title="Sampa 4u | Fontes de Dados">
  <link rel="stylesheet" href={`${base}styles.css`} slot="head" />
  <link rel="stylesheet" href={`${base}fontes.css`} slot="head" />

  <main>
    <hr/>
    <section class="about" aria-labelledby="section-title">
      <div class="info-container">
        <h2 id="section-title">Desenvolvimento e Transparência</h2>
        
        <div class="actions" style="margin-bottom: 20px;">
          <a href="https://github.com/Rafabs/SP-4-u-Web" target="_blank" rel="noopener noreferrer">
            <img
              src="https://img.shields.io/badge/GitHub-100000?style=for-the-badge&logo=github&logoColor=white"
              alt="Acessar o repositório do Sampa 4u no GitHub"
            />
          </a>
        </div>
        
        <p>
          <strong>Status do Build:</strong> Todas as atualizações seguem o fluxo de
          integração contínua, consulte no link acima.
        </p>
      </div>
    </section>
    <hr/>
  </main>
</Layout>
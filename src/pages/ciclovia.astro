---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout title="Sampa 4u | Ciclovias">
  <link rel="stylesheet" href={`${base}/map.css`} slot="head" />
  <link rel="stylesheet" href={`${base}/ciclovia.css`} slot="head" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" slot="head" />

  <!-- HERO -->
  <section class="hero hero-ciclo">
    <div class="hero-bg">
      <div class="hero-grid"></div>
    </div>

    <div class="hero-lines" id="ciclo-canvas"></div>

    <div class="hero-content">
      <div class="hero-tag">Mobilidade Ativa · São Paulo</div>
      <h1 class="hero-h1">Rede Cicloviária<br><span style="color:#32e622;">de São Paulo</span></h1>
      <p class="hero-sub">
        Explore ciclovias, ciclofaixas e bicicletários da cidade de São Paulo
        com dados do GeoSampa — Prefeitura de São Paulo.
      </p>
      <div class="hero-ctas">
        <a href="#map" class="btn-hero-primary" style="background:#32e622;color:#0a0a0f;">Ver Mapa</a>
      </div>
      <div class="hero-stats">
        <div class="stat" style="border-color:#32e622;">
          <div class="stat-val">1.400+</div>
          <div class="stat-label">km de ciclovias</div>
        </div>
        <div class="stat" style="border-color:#32e622;">
          <div class="stat-val">400+</div>
          <div class="stat-label">Bicicletários</div>
        </div>
        <div class="stat" style="border-color:#32e622;">
          <div class="stat-val">GeoSampa</div>
          <div class="stat-label">Fonte dos dados</div>
        </div>
      </div>
    </div>
  </section>

  <div class="map-wrapper" id="map-wrapper">
    <div id="map"></div>
    <div id="map-controls" class="custom-controls">
      <h3>Camadas</h3>
      <label><input type="checkbox" id="check-ciclo" /> Ciclovias</label>
      <label><input type="checkbox" id="check-bike" /> Bicicletários</label>
    </div>
  </div>

  <hr />
  <div id="dynamic-systems-info"></div>
  <hr />

  <section class="about">
    <div class="info-container">
      <h2>Desenvolvimento e Transparência</h2>
      <div class="actions" style="margin-bottom: 20px;">
        <a href="https://github.com/Rafabs/SP-4-u-Web" target="_blank">
          <img
            src="https://img.shields.io/badge/GitHub-100000?style=for-the-badge&logo=github&logoColor=white"
            alt="github"
          />
        </a>
      </div>
      <p>
        <strong>Status do Build:</strong> Todas as atualizações seguem o fluxo de
        integração contínua.
      </p>
    </div>
  </section>

  <script>
    import { loadMapData } from "../lib/map-logic";
    loadMapData();

    // Bikes animadas — horizontal
    const CICLO_COLORS = [
      '#32e622','#28cc1a','#3fff2f','#20aa14',
      '#32e622','#25bb18','#38dd25','#1e9912',
    ];
    const canvas = document.getElementById('ciclo-canvas');
    if (canvas) {
      CICLO_COLORS.forEach((color, i) => {
        const y = 40 + i * 55;

        const track = document.createElement('div');
        track.style.cssText = `
          position:absolute;left:0;right:0;
          top:${y}px;height:2px;
          background:${color};opacity:.12;
        `;
        canvas.appendChild(track);

        const icon = document.createElement('span');
        icon.className = 'material-symbols-outlined';
        icon.textContent = i % 3 === 0 ? 'directions_bike'
          : i % 3 === 1 ? 'pedal_bike'
          : 'electric_bike';
        icon.style.cssText = `
          position:absolute;top:${y - 12}px;
          font-size:${18 + (i % 3) * 6}px;
          color:${color};opacity:.6;
          animation:bus-run ${6 + i * 1.2}s linear infinite;
          animation-delay:${-i * 0.8}s;
        `;
        canvas.appendChild(icon);
      });
    }
  </script>
</Layout>
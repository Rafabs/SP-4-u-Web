---
interface Props {
    title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />        
    <link rel="stylesheet" href={`${base}styles.css`}/>   
    <link rel="icon" href="https://raw.githubusercontent.com/Rafabs/SP-4-u/main/Mapa_dos_Trilhos/Favicon/SP4U_LOGO.ico" type="image/x-icon">
    <slot name="head" />    
</head>
<body>
    <button class="theme-toggle" id="theme-btn" title="Alternar tema">🌓</button>
    <header>
        <div class="logo-container">
            <a href={`${base}`}>
                <img class="logo" src="https://raw.githubusercontent.com/Rafabs/SP-4-u/main/Mapa_dos_Trilhos/Imgs/SP4U_LOGO.jpg" alt="Logo do Projeto">
            </a>
        </div>
        <button id="backToTop"><span class="material-symbols-outlined">arrow_upward</span></button>

        <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menu">
            <span></span><span></span><span></span>
        </button>

        <nav class="nav-menu" id="nav-menu">
            <a href={`${base}`}><span class="material-symbols-outlined">home</span><span>Início</span></a>
            <a href={`${base}sptrans`}><span class="material-symbols-outlined">directions_bus</span><span>SPTrans</span></a>
            <a href={`${base}artesp`}><span class="material-symbols-outlined">commute</span><span>ARTESP</span></a>
            <a href={`${base}gtfs`}><span class="material-symbols-outlined">history</span><span>GTFS</span></a>
            <a href={`${base}qualidade_ar`}><span class="material-symbols-outlined">air</span><span>Ar (AQI)</span></a>
            <a href={`${base}ciclovia`}><span class="material-symbols-outlined">directions_bike</span><span>Ciclovia</span></a>
            <a href={`${base}origem_destino`}><span class="material-symbols-outlined">route</span><span>Pesquisa OD</span></a>
            <a href={`${base}demanda`}><span class="material-symbols-outlined">group</span><span>Demanda</span></a>
            <a href={`${base}mapa`}><span class="material-symbols-outlined">map</span><span>Mapa</span></a>
        </nav>
    </header>

    <slot /> 

    <footer>
        <div class="footer-content">
            <div class="footer-info">
                <div style="text-align: center;"> 🌆 <i>Sua jornada por São Paulo começa aqui!</i> 🌆 </div>
                <p class="copyright">&copy; 2023 - 2026 | <strong>Sampa 4u</strong></p>
                <p class="author">Desenvolvido por <span>Rafael Barbosa</span></p>
            </div>
            <a href={`${base}versao`}>Versões de Desenvolvimento e Licença</a>
            <div class="footer-badges">
                <img src="https://img.shields.io/badge/Visual_Studio_Code-0078D4?style=for-the-badge&logo=visual%20studio%20code&logoColor=white" alt="VSCode">
                <img src="https://img.shields.io/badge/Astro-FF5D01?style=for-the-badge&logo=astro&logoColor=white" alt="Astro">
                <img src="https://img.shields.io/badge/CSS3-1572B6?style=for-the-badge&logo=css3&logoColor=white" alt="CSS3">
                <img src="https://img.shields.io/badge/JavaScript-F7DF1E?style=for-the-badge&logo=javascript&logoColor=black" alt="JS">
            </div>
        </div>
    </footer>

    <script is:inline src={`${base}components.js`}></script>
    <script is:inline src={`${base}bottom-theme.js`}></script>
    <script is:inline src={`${base}menu-toggle.js`}></script>
</body>
</html>